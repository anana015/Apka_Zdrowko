{
  "name": "dziennik-zdrowia",
  "version": "0.7.0",
  "private": true,
  "description": "Prywatna aplikacja PWA: sen, nastrój, dolegliwości, leki, badania.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "precache": "node scripts/generuj-precache.mjs",
    "precache:check": "node scripts/generuj-precache.mjs --check",
    "serve": "python3 -m http.server 8080",
    "typecheck": "tsc -p jsconfig.json",
    "ustaw-supabase": "node scripts/ustaw-supabase.mjs",
    "supabase": "supabase",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "supabase": "3.4.0",
    "typescript": "^5.9.3"
  }
}
